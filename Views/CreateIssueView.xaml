<UserControl
    x:Class="JiraClient.Views.CreateIssueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JiraClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource FontBrush}" />
            <Setter Property="Background" Value="{StaticResource GrayBrush3}" />
            <Setter Property="BorderBrush" Value="{StaticResource GrayBrush3}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--  박스 (Border)  -->
                            <Border
                                x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                                <Grid>
                                    <!--  선택된 값 영역  -->
                                    <ContentPresenter
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />

                                    <!--  드랍다운 버튼  -->
                                    <ToggleButton
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False"
                                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <Path
                                            Width="10"
                                            Height="6"
                                            Margin="5"
                                            Data="M 0 0 L 10 0 L 5 6 Z"
                                            Fill="{StaticResource FontBrush}"
                                            Stretch="Uniform" />
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!--  드랍다운 팝업  -->
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide"
                                StaysOpen="False">
                                <Border
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    Background="{StaticResource GrayBrush3}"
                                    BorderBrush="{StaticResource GrayBrush3}"
                                    BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!--  트리거 설정  -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource GrayBrush1}" />
            <Setter Property="Foreground" Value="{StaticResource FontBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="Bold"
                Style="{StaticResource LightTextBlockStyle}"
                Text="Create Issue" />

            <!--  Project Selector  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Project*" />
            <ComboBox
                Margin="0,0,0,5"
                Foreground="{StaticResource FontBrush}"
                ItemsSource="{Binding Projects}"
                SelectedItem="{Binding SelectedProject}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="Bold" Text="{Binding Key}" />
                            <TextBlock Text=" - " />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!--  Issue Type  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Issue Type*" />
            <ComboBox
                Margin="0,0,0,5"
                Foreground="{StaticResource FontBrush}"
                ItemsSource="{Binding IssueTypes}"
                SelectedItem="{Binding SelectedIssueType}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <!--TODO
                            <Image
                                Width="16"
                                Height="16"
                                Margin="0,0,5,0"
                                Source="{Binding IconImage}" />-->
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!--  Summary  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Summary" />
            <TextBox
                Margin="0,0,0,5"
                Background="{StaticResource GrayBrush3}"
                BorderThickness="0"
                Foreground="{StaticResource FontBrush}"
                Text="{Binding Summary}" />

            <!--  Description  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Description" />
            <TextBox
                Height="100"
                Margin="0,0,0,5"
                AcceptsReturn="True"
                Background="{StaticResource GrayBrush3}"
                BorderThickness="0"
                Foreground="{StaticResource FontBrush}"
                Text="{Binding Description}"
                VerticalScrollBarVisibility="Auto" />

            <!--  Labels  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Labels" />
            <ComboBox
                Margin="0,0,0,5"
                Foreground="{StaticResource FontBrush}"
                IsEditable="True"
                ItemsSource="{Binding Labels}"
                SelectedItem="{Binding SelectedLabel}" />

            <!--  Priority  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Priority" />
            <ComboBox
                Margin="0,0,0,5"
                Foreground="{StaticResource FontBrush}"
                IsEditable="True"
                ItemsSource="{Binding Priorities}"
                SelectedItem="{Binding SelectedPriority}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontWeight="Bold" Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel>
                <!--  Estimates  -->
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Original Estimate" />
                        <TextBox
                            Background="{StaticResource GrayBrush3}"
                            BorderThickness="0"
                            Foreground="{StaticResource FontBrush}"
                            Text="{Binding OriginalEstimate}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Remaining Estimate" />
                        <TextBox
                            Background="{StaticResource GrayBrush3}"
                            BorderThickness="0"
                            Foreground="{StaticResource FontBrush}"
                            Text="{Binding RemainingEstimate}" />
                    </StackPanel>
                </StackPanel>

                <!--  Start Date  -->
                <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Start Date" />
                <DatePicker
                    Margin="0,0,0,5"
                    BorderThickness="0"
                    Foreground="{StaticResource DisabledFontBrush}"
                    SelectedDate="{Binding StartDate}" />

                <!--  Attachment  -->
                <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Attachment" />
                <Border
                    Margin="0,0,0,5"
                    Padding="20"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource GrayBrush3}"
                    BorderBrush="Gray"
                    BorderThickness="0">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="Drop files or click to browse" />
                    <!--  Drag & Drop 파일 처리는 코드비하인드에서  -->
                </Border>

                <!--  Due Date  -->
                <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Due Date" />
                <DatePicker
                    Margin="0,0,0,5"
                    BorderThickness="0"
                    Foreground="{StaticResource DisabledFontBrush}"
                    SelectedDate="{Binding DueDate}" />

                <!--  Assignee  -->
                <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Assignee" />
                <ComboBox
                    Foreground="{StaticResource FontBrush}"
                    IsEditable="True"
                    ItemsSource="{Binding Assignees}"
                    SelectedItem="{Binding SelectedAssignee}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!--  Submit  -->
            <Button
                Width="160"
                Height="40"
                Margin="0,30"
                HorizontalAlignment="Center"
                Command="{Binding SubmitIssueCommand}"
                Content="Create" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
