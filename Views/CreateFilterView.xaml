<UserControl
    x:Class="JiraClient.Views.CreateFilterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JiraClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JiraClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,10"
            FontSize="20"
            FontWeight="Bold"
            Style="{StaticResource LightTextBlockStyle}"
            Text="Create Filter" />

        <TextBlock
            Grid.Column="1"
            Margin="0,0,0,10"
            d:Text="Filters and Custom JQL"
            FontSize="20"
            FontWeight="Bold"
            Style="{StaticResource LightTextBlockStyle}"
            Text="Filters and Custom JQL" />

        <!--  Filter List  -->
        <ListBox
            x:Name="FilterListBox"
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,10,0"
            AllowDrop="True"
            DisplayMemberPath="FilterName"
            Drop="FilterListBox_Drop"
            ItemsSource="{Binding JqlFilters}"
            MouseMove="FilterListBox_MouseMove"
            PreviewMouseLeftButtonDown="FilterListBox_PreviewMouseLeftButtonDown"
            SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />

        <!--  Filter Editor  -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Orientation="Vertical">
            <TextBlock
                d:Text="Filter Name"
                Foreground="{StaticResource FontBrush}"
                Text="Filter Name" />
            <TextBox
                Margin="0,0,0,10"
                Padding="5"
                Background="{StaticResource GrayBrush3}"
                BorderThickness="0"
                Foreground="{StaticResource FontBrush}"
                Style="{StaticResource TextBoxStyle}"
                Text="{Binding NewFilterName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                d:Text="Filter JQL"
                Foreground="{StaticResource FontBrush}"
                Text="Filter JQL" />
            <TextBox
                Margin="0,0,0,10"
                Padding="5"
                d:Text="project = C10"
                Background="{StaticResource GrayBrush3}"
                BorderThickness="0"
                Foreground="{StaticResource FontBrush}"
                Style="{StaticResource TextBoxStyle}"
                Text="{Binding NewFilterJQL, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Command="{Binding AddFilterCommand}"
                    Content="Add" />
                <Button
                    Margin="0,0,10,0"
                    Command="{Binding UpdateFilterCommand}"
                    Content="Update"
                    IsEnabled="{Binding SelectedFilter, Converter={StaticResource NullToBoolConverter}}" />
                <Button
                    Command="{Binding DeleteFilterCommand}"
                    Content="Delete"
                    IsEnabled="{Binding SelectedFilter, Converter={StaticResource NullToBoolConverter}}" />
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>
