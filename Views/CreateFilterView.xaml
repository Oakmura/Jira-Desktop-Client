<UserControl
    x:Class="JiraClient.Views.CreateFilterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JiraClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JiraClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            d:Text="Filters and Custom JQL"
            FontSize="16"
            FontWeight="Bold"
            Style="{StaticResource LightTextBlockStyle}"
            Text="{Binding Title}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!--  Filter List  -->
            <ListBox
                Grid.Column="0"
                Margin="0,0,10,0"
                ItemsSource="{Binding JqlFilters}"
                SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <!--  Filter Editor  -->
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBox
                    Margin="0,0,0,10"
                    Padding="5"
                    d:Text="project = C10"
                    Background="{StaticResource GrayBrush3}"
                    BorderThickness="0"
                    FontSize="14"
                    Foreground="{StaticResource FontBrush}"
                    Text="{Binding NewFilterText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button
                        Margin="0,0,10,0"
                        Command="{Binding AddFilterCommand}"
                        Content="Add" />
                    <Button
                        Margin="0,0,10,0"
                        Command="{Binding UpdateFilterCommand}"
                        Content="Update"
                        IsEnabled="{Binding SelectedFilter, Converter={StaticResource NullToBoolConverter}}" />
                    <Button
                        Command="{Binding DeleteFilterCommand}"
                        Content="Delete"
                        IsEnabled="{Binding SelectedFilter, Converter={StaticResource NullToBoolConverter}}" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
