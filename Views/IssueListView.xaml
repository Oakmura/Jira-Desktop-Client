<UserControl
    x:Class="JiraClient.Views.IssueListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <TreeView
            x:Name="IssueTreeView"
            Background="{StaticResource GrayBrush2}"
            BorderThickness="0"
            ItemsSource="{Binding HierarchicalIssueList}"
            KeyDown="IssueTreeView_KeyDown"
            MouseDoubleClick="SelectedIssueDoubleClick"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItemChanged="SelectedIssueChanged">

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <!--  트리 항목 간 간격 제거  -->
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="11" />
                    <!--  들여쓰기 감소  -->
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="0" />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>

            <!--  Root node: HierarchicalIssueList  -->
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <!--  Group Name  -->
                    <TextBlock
                        FontWeight="Bold"
                        Foreground="{StaticResource FontBrush}"
                        Text="{Binding Name}" />

                    <!--  Child node: JiraIssue items  -->
                    <HierarchicalDataTemplate.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Fields.SubTasks}">
                            <DockPanel ToolTip="{Binding Fields.Summary}">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="DeleteIssueButtonClick" Header="Delete Issue" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>

                                <DockPanel.Style>
                                    <Style TargetType="DockPanel">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Opacity="0.5" Color="{StaticResource SelectedBackgroundColor}" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DockPanel.Style>

                                <!--  Issue Type Icon 추가  -->

                                <!--TODO
                                <Image
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Source="{Binding Fields.IssueType.IconImage}"
                                    Stretch="Uniform" />-->

                                <!--  Issue Key  -->
                                <TextBlock
                                    Margin="0,0,5,0"
                                    FontWeight="Bold"
                                    Text="{Binding Key}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="LightGreen" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Fields.Status.Name}" Value="In Progress">
                                                    <Setter Property="Foreground" Value="#ffffbb22" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Fields.Status.Name}" Value="Closed">
                                                    <Setter Property="Foreground" Value="#ffff4455" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!--  Issue Summary  -->
                                <TextBlock Style="{StaticResource LightTextBlockStyle}" Text="{Binding Fields.Summary}" />
                            </DockPanel>

                            <!--  재귀: Issue Fields.SubTasks 재귀적 표시  -->
                            <HierarchicalDataTemplate.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Fields.SubTasks}">
                                    <DockPanel ToolTip="{Binding Fields.Description}">
                                        <DockPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Click="DeleteIssueButtonClick" Header="Delete Issue" />
                                            </ContextMenu>
                                        </DockPanel.ContextMenu>

                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Opacity="0.5" Color="{StaticResource SelectedBackgroundColor}" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>

                                        <!--  재귀 하위 이슈들  -->
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            FontWeight="Bold"
                                            Text="{Binding Key}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="LightGreen" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Fields.Status.Name}" Value="In Progress">
                                                            <Setter Property="Foreground" Value="#ffffbb22" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Fields.Status.Name}" Value="Closed">
                                                            <Setter Property="Foreground" Value="#ffff4455" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Style="{StaticResource LightTextBlockStyle}" Text="{Binding Fields.Summary}" />
                                    </DockPanel>
                                </HierarchicalDataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>

                        </HierarchicalDataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>

                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
