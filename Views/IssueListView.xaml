<UserControl
    x:Class="JiraClient.Views.IssueListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JiraClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utilities="clr-namespace:JiraClient.Utilities"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid DataContextChanged="OnDataContextChanged">

        <ScrollViewer
            x:Name="scrollViewer"
            Background="{StaticResource GrayBrush2}"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel ToolTip="{Binding Fields.Description}">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.5" Color="{StaticResource SelectedBackgroundColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>

                            <!--  Time Placeholder (JIRA doesn't have exact 'Time', so using Created Time)  -->
                            <!--<TextBlock
                                Margin="5,0"
                                Text="{Binding Fields.FormattedCreated, StringFormat=yyyy-MM-dd HH:mm}"
                                TextWrapping="Wrap" />-->

                            <!--  Issue Key  -->
                            <TextBlock
                                Margin="0,0,5,0"
                                FontWeight="Bold"
                                Text="{Binding Key}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="LightGreen" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Fields.Status.Name}" Value="In Progress">
                                                <Setter Property="Foreground" Value="#ffffbb22" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Fields.Status.Name}" Value="Closed">
                                                <Setter Property="Foreground" Value="#ffff4455" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!--  Issue Summary  -->
                            <TextBlock Style="{StaticResource LightTextBlockStyle}" Text="{Binding Fields.Summary}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>
    </Grid>
</UserControl>
