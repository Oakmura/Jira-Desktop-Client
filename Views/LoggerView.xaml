<UserControl
    x:Class="JiraClient.Views.LoggerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JiraClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utilities="clr-namespace:JiraClient.Utilities"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="{StaticResource GrayBrush4}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <EventSetter Event="Click" Handler="OnMessageFilterButtonClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border
                            x:Name="outerBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="true">
                            <Border
                                x:Name="innerBorder"
                                Margin="1"
                                Background="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="outerBorder" Property="BorderBrush" Value="{Binding Background, ElementName=innerBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="innerBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="innerBorder" Property="Opacity" Value="0.2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border
            Height="32"
            VerticalAlignment="Top"
            Background="{StaticResource GrayBrush3}"
            DockPanel.Dock="Top">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.3"
                    ShadowDepth="0" />
            </Border.Effect>
            <StackPanel
                Margin="4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Width="40"
                    Margin="1,0"
                    VerticalAlignment="Center"
                    Click="OnClearButtonClick"
                    Content="Clear"
                    Focusable="False"
                    FontSize="12" />
                <ToggleButton
                    x:Name="toggleButtonInfo"
                    Width="24"
                    Margin="1,0"
                    Background="{StaticResource GreenBrush}"
                    Content="info"
                    IsChecked="True"
                    ToolTip="Toggle information messages" />
                <ToggleButton
                    x:Name="toggleButtonWarnings"
                    Width="24"
                    Margin="1,0"
                    Background="{StaticResource OrangeBrush}"
                    Content="warn"
                    IsChecked="True"
                    ToolTip="Toggle warning messages" />
                <ToggleButton
                    x:Name="toggleButtonErrors"
                    Width="24"
                    Margin="1,0"
                    Background="{StaticResource RedBrush}"
                    Content="error"
                    IsChecked="True"
                    ToolTip="Toggle error messages" />
            </StackPanel>
        </Border>

        <ScrollViewer
            x:Name="scrollViewer"
            Background="{StaticResource GrayBrush2}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Source={x:Static utilities:Logger.FilteredMessages}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel ToolTip="{Binding MetaData}">
                            <DockPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="OnCopyLogMessageClick" Header="Copy Message" />
                                </ContextMenu>
                            </DockPanel.ContextMenu>

                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Opacity="0.5" Color="{StaticResource SelectedBackgroundColor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <TextBlock Margin="5,0" Text="{Binding Time, StringFormat=hh:mm:ss}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="LightGreen" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageType}" Value="{x:Static utilities:MessageType.Warning}">
                                                <Setter Property="Foreground" Value="#ffffbb22" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding MessageType}" Value="{x:Static utilities:MessageType.Error}">
                                                <Setter Property="Foreground" Value="#ffff4455" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock
                                Style="{StaticResource LightTextBlockStyle}"
                                Text="{Binding Message}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
