<UserControl
    x:Class="JiraClient.Views.ViewIssueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JiraClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:JiraClient.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:ViewIssueVM}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">
            <TextBlock
                Margin="0,0,0,5"
                FontSize="20"
                FontWeight="Bold"
                Style="{StaticResource LightTextBlockStyle}"
                Text="View / Edit Issue" />
            <TextBlock
                Margin="0,0,0,5"
                d:Text="C10-21 / C10-40"
                FontSize="14"
                FontWeight="Bold"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding IssuePath}" />

            <!--  Project  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Project" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Project.Name}" />

            <!--  Issue Type  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Issue Type" />
            <ComboBox
                Margin="0,0,0,5"
                DisplayMemberPath="Name"
                Foreground="{StaticResource FontBrush}"
                ItemsSource="{Binding IssueTypes}"
                SelectedItem="{Binding SelectedIssueType, Mode=TwoWay}" />

            <!--  Summary  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Summary" />
            <TextBox
                Margin="0,0,0,5"
                FontSize="12"
                Text="{Binding Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Description  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Description" />
            <TextBox
                MinHeight="100"
                Margin="0,0,0,5"
                AcceptsReturn="True"
                FontSize="12"
                Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />

            <!--  Assignee  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Assignee" />
            <ComboBox
                Margin="0,0,0,5"
                DisplayMemberPath="DisplayName"
                Foreground="{StaticResource FontBrush}"
                IsTextSearchEnabled="True"
                ItemsSource="{Binding Assignees}"
                SelectedItem="{Binding SelectedAssignee, Mode=TwoWay}" />

            <!--  Due Date  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Due Date" />
            <DatePicker Margin="0,0,0,5" SelectedDate="{Binding DueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Buttons  -->
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Width="160"
                    Height="40"
                    Margin="0,30,10,30"
                    HorizontalAlignment="Center"
                    Command="{Binding UpdateIssueCommand}"
                    Content="Update" />
                <Button
                    Width="160"
                    Height="40"
                    Margin="0,30"
                    HorizontalAlignment="Center"
                    Command="{Binding ResetIssueCommand}"
                    Content="Reset" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
