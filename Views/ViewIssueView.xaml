<UserControl
    x:Class="JiraClient.Views.ViewIssueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JiraClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer DataContext="{Binding Issue}" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">

            <!--  Title  -->
            <TextBlock
                Margin="0,0,0,5"
                FontSize="20"
                FontWeight="Bold"
                Style="{StaticResource LightTextBlockStyle}"
                Text="View Issue" />

            <!--  Issue Path  -->
            <TextBlock
                Margin="0,0,0,5"
                FontSize="14"
                FontWeight="Bold"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding DataContext.IssuePath, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <!--  Project  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Project" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.Project.Name}" />

            <!--  Issue Type  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Issue Type" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.IssueType.Name}" />

            <!--  Summary  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Summary" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.Summary}" />

            <!--  Description  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Description" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.Description}"
                TextWrapping="Wrap" />

            <!--  Status  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Status" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.Status.Name}" />

            <!--  Labels  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Labels" />
            <ItemsControl MinHeight="20" ItemsSource="{Binding Fields.Labels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,0,5,0"
                            Style="{StaticResource LightTextBlockStyle}"
                            Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Assignee  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Assignee" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.Assignee.DisplayName}" />

            <!--  Reporter  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Reporter" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.Reporter.DisplayName}" />

            <!--  Creator  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Creator" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.Creator.DisplayName}" />

            <!--  Resolution  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Resolution" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.Resolution.Name}" />

            <!--  Created  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Created" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.FormattedCreated}" />

            <!--  Updated  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Updated" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.FormattedUpdated}" />

            <!--  Due Date  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Due Date" />
            <TextBlock
                Margin="0,0,0,5"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding Fields.FormattedDueDate}" />

            <!--  Linked Issues  -->
            <TextBlock Foreground="{StaticResource DisabledFontBrush}" Text="Linked Issues" />
            <ItemsControl Margin="0,5,0,0" ItemsSource="{Binding Fields.IssueLinks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                Style="{StaticResource LightTextBlockStyle}"
                                Text="{Binding InwardDescription}"
                                Visibility="{Binding InwardDescription, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            <TextBlock
                                Style="{StaticResource LightTextBlockStyle}"
                                Text="{Binding OutwardDescription}"
                                Visibility="{Binding OutwardDescription, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
