<UserControl
    x:Class="JiraClient.Views.ViewIssueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:JiraClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer DataContext="{Binding Issue}">
        <StackPanel Margin="0,0,0,20" Orientation="Vertical">
            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="Bold"
                Style="{StaticResource LightTextBlockStyle}"
                Text="View Issue" />

            <!--  Issue Header  -->
            <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Style="{StaticResource LightTextBlockStyle}"
                Text="{Binding DataContext.IssuePath, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <TextBox
                Margin="0,5,0,10"
                FontSize="16"
                FontWeight="SemiBold"
                Style="{StaticResource TextBoxStyle}"
                Text="{Binding Fields.Summary, Mode=TwoWay}" />

            <!--  Basic Info Section  -->
            <GroupBox Margin="0,10,0,0" Header="Details">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Style="{StaticResource LightTextBlockStyle}"
                            Text="{Binding}" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="Type:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        FontSize="14"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding Fields.IssueType.Name, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="Status:" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="14"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding Fields.Status.Name, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="Priority:" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        FontSize="14"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding Fields.Priority.Name, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="Created:" />
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        FontSize="14"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="{Binding Fields.FormattedCreated}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="Updated:" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        FontSize="14"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="{Binding Fields.FormattedUpdated}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="Resolution:" />
                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        FontSize="14"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding Fields.Resolution.Name, Mode=TwoWay}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="Labels:" />
                    <TextBlock Grid.Row="6" Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding Fields.Labels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        FontSize="14"
                                        Style="{StaticResource LightTextBlockStyle}"
                                        Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </TextBlock>
                </Grid>
            </GroupBox>

            <!--  People Section  -->
            <GroupBox Margin="0,10,0,0" Header="People">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Style="{StaticResource LightTextBlockStyle}"
                            Text="{Binding}" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <StackPanel Margin="10">
                    <TextBlock
                        FontSize="14"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="{Binding Fields.Assignee.DisplayName, StringFormat='Assignee: {0}'}" />
                    <TextBlock
                        FontSize="14"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="{Binding Fields.Reporter.DisplayName, StringFormat='Reporter: {0}'}" />
                    <TextBlock
                        FontSize="14"
                        Style="{StaticResource LightTextBlockStyle}"
                        Text="{Binding Fields.Creator.DisplayName, StringFormat='Creator: {0}'}" />
                </StackPanel>
            </GroupBox>

            <!--  Description  -->
            <GroupBox Margin="0,10,0,0" Header="Description">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Style="{StaticResource LightTextBlockStyle}"
                            Text="{Binding}" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <TextBlock
                    Margin="10"
                    FontSize="14"
                    Style="{StaticResource LightTextBlockStyle}"
                    Text="{Binding Fields.Description}"
                    TextWrapping="Wrap" />
            </GroupBox>

            <!--  Linked Issues  -->
            <GroupBox
                MinHeight="30"
                Margin="0,10,0,0"
                Header="Linked Issues">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Style="{StaticResource LightTextBlockStyle}"
                            Text="{Binding}" />
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <ItemsControl ItemsSource="{Binding Fields.IssueLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Style="{StaticResource LightTextBlockStyle}"
                                    Text="{Binding InwardDescription}"
                                    Visibility="{Binding InwardDescription, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                                <TextBlock
                                    Margin="0,0,5,0"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Style="{StaticResource LightTextBlockStyle}"
                                    Text="{Binding OutwardDescription}"
                                    Visibility="{Binding OutwardDescription, Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
