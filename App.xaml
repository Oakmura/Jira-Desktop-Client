<Application
    x:Class="JiraClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:JiraClient"
    xmlns:ui="http://schemas.modernwpf.com/2019">
    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources />
                <ui:XamlControlsResources />

                <ResourceDictionary Source="pack://application:,,,/Dictionaries/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Dictionaries/ComboBoxTemplates.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Dictionaries/ControlTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Application.Resources>
</Application>
