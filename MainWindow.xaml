<Window
    x:Class="JiraClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:JiraClient"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:views="clr-namespace:JiraClient.Views"
    Title="Jira Desktop Client"
    Width="1920"
    Height="1080"
    AllowDrop="True"
    Closing="OnWindowClosingEvent"
    Icon="Resources/jira-icon.ico"
    Style="{StaticResource WindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="createIssueButton"
                Margin="0,0,5,0"
                Click="OnIssueTypeButtonClick"
                Content="Create Issue" />
            <Button
                x:Name="deleteIssueButton"
                Margin="0,0,5,0"
                Click="OnIssueTypeButtonClick"
                Content="Delete Issue" />
            <Button
                x:Name="viewIssueButton"
                Margin="0,0,5,0"
                Click="OnIssueTypeButtonClick"
                Content="View Issue" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="300" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="300" MinHeight="300" />
                </Grid.RowDefinitions>
                <views:IssueListView
                    x:Name="issueListView"
                    Grid.Row="0"
                    Background="{StaticResource GrayBrush2}" />
                <GridSplitter
                    Grid.Row="1"
                    Height="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="Transparent" />
                <Grid
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    Background="{StaticResource GrayBrush2}" />
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Left"
                Background="Transparent" />

            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" MinHeight="300" />
                </Grid.RowDefinitions>

                <UserControl Grid.Row="0">
                    <Grid Background="{StaticResource GrayBrush2}" />
                </UserControl>

                <GridSplitter
                    Grid.Row="1"
                    Height="5"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="Transparent" />

                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <views:LoggerView Grid.Column="1" />
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>